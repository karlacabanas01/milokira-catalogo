rules_version = '2';

/**
 * Reglas de Firebase Storage de Milokira.
 *
 * Solo guarda fotos del catálogo, que son públicas por definición: se ven en
 * la web. Subirlas y reemplazarlas es del negocio.
 */
service firebase.storage {
  match /b/{bucket}/o {

    match /plantas/{archivo} {
      allow read: if true;
      // Solo imágenes, hasta 10 MB: el cliente ya convierte a WebP antes de
      // subir, así que un archivo más grande que esto es un error o un abuso.
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
